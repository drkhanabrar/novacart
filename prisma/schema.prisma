generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String               @id @default(uuid())
  title        String
  slug         String               @unique
  description  String?
  basePrice    Decimal              @db.Decimal(10, 2)
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id])
  brandId      String?
  brand        Brand?               @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]
  intelligence ProductIntelligence?
  orderItems   OrderItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Soft-delist flag (Stage 5). Hidden products stay in the database with
  // full history — never hard-deleted — but are excluded from the storefront.
  isActive     Boolean              @default(true)
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String   @unique
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  imageUrl  String?
  attributes  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductIntelligence {
  id                 String   @id @default(uuid())
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  aiScore            Decimal  @db.Decimal(5, 2)
  profitabilityIndex Decimal? @db.Decimal(10, 2)
  demandLevel        String?
  insights           String?
  lastEvaluatedAt    DateTime? @default(now())
  matchConfidence    Int?

  // Stage 5: counts consecutive low-demand readings. The free Google Trends
  // data source is noisy between calls, so we require 2 in a row before
  // actually delisting — protects against a single bad reading.
  consecutiveLowReadings Int @default(0)
  supplierCostUsd    Decimal? @db.Decimal(10, 2)
  supplierName       String?
  supplierProductId  String?
  supplierUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  orders              Order[]   @relation("UserOrders")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation("UserOrders", fields: [userId], references: [id])
  total     Decimal     @db.Decimal(10, 2)
  status    String      @default("PENDING")
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}