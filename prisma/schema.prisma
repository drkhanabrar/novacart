generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String               @id @default(uuid())
  title        String
  slug         String               @unique
  description  String?
  basePrice    Decimal              @db.Decimal(10, 2)
  categoryId   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  brandId      String?
  isActive     Boolean              @default(true)
  orderItems   OrderItem[]
  brand        Brand?               @relation(fields: [brandId], references: [id])
  category     Category?            @relation(fields: [categoryId], references: [id])
  intelligence ProductIntelligence?
  variants     ProductVariant[]
  events        ProductEvent[]
  dailyMetrics  ProductDailyMetric[]
  lifecycle     ProductLifecycle?
  transitions   LifecycleTransition[]
  predictions   NovaPrediction[]
  decisions     NovaDecision[]

  @@index([isActive])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  name       String
  sku        String   @unique
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  attributes Json?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MarketResearchRun {
  id            String            @id @default(uuid())
  region        String            @default("IN")
  status        String            @default("RUNNING")
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  sourceSummary Json?
  notes         String?
  candidates    MarketCandidate[]
}

model MarketCandidate {
  id                    String            @id @default(uuid())
  runId                 String
  keyword               String
  normalizedName        String
  category              String?
  demandScore           Decimal           @db.Decimal(5, 2)
  trendScore            Decimal?          @db.Decimal(5, 2)
  trendVelocity         Decimal?          @db.Decimal(5, 2)
  shoppingScore         Decimal?          @db.Decimal(5, 2)
  socialScore           Decimal?          @db.Decimal(5, 2)
  competitionScore      Decimal?          @db.Decimal(5, 2)
  expectedMarginPercent Decimal?          @db.Decimal(6, 2)
  repeatPurchaseScore   Decimal?          @db.Decimal(5, 2)
  returnRiskScore       Decimal?          @db.Decimal(5, 2)
  serviceRiskScore      Decimal?          @db.Decimal(5, 2)
  operationalEaseScore  Decimal?          @db.Decimal(5, 2)
  supplierScore         Decimal?          @db.Decimal(5, 2)
  finalScore            Decimal           @db.Decimal(5, 2)
  confidence            Int               @default(0)
  decision              String            @default("REVIEW")
  reason                String?
  evidence              Json?

  /*
   * Admin approval workflow.
   *
   * Research no longer publishes anything by itself. It scores candidates and
   * parks them here; a human decides what reaches the storefront.
   *
   * PENDING | APPROVED | REJECTED | PUBLISHED | FAILED
   */
  reviewStatus          String            @default("PENDING")
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNote            String?
  publishedProductId    String?
  publishError          String?

  /// Full ResearchCandidate as scored, so approval can replay the exact
  /// decision later without re-running research or losing supplier match data.
  candidateSnapshot     Json?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  run                   MarketResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, keyword])
  @@index([runId, finalScore])
  @@index([decision])
  @@index([reviewStatus, finalScore])
}

model ProductIntelligence {
  id                     String    @id @default(uuid())
  productId              String    @unique
  aiScore                Decimal   @db.Decimal(5, 2)
  insights               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  demandLevel            String?
  lastEvaluatedAt        DateTime? @default(now())
  profitabilityIndex     Decimal?  @db.Decimal(10, 2)
  matchConfidence        Int?
  supplierCostUsd        Decimal?  @db.Decimal(10, 2)
  supplierName           String?
  supplierProductId      String?
  supplierUrl            String?
  consecutiveLowReadings Int       @default(0)
  competitionScore       Decimal?  @db.Decimal(5, 2)
  evaluationConfidence   Int?
  evidence               Json?
  marginPercent          Decimal?  @db.Decimal(6, 2)
  marketScore            Decimal?  @db.Decimal(5, 2)
  observedReturnRate     Decimal?  @db.Decimal(6, 3)
  operationalEaseScore   Decimal?  @db.Decimal(5, 2)
  repeatPurchaseScore    Decimal?  @db.Decimal(5, 2)
  returnRiskScore        Decimal?  @db.Decimal(5, 2)
  serviceRiskScore       Decimal?  @db.Decimal(5, 2)
  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String
  name                String?
  /// USER | ADMIN. Only ADMIN may reach /admin and act on NOVA proposals.
  /// Defaults to USER so an existing account cannot silently gain access.
  role                String        @default("USER")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  resetTokenExpiresAt DateTime?
  resetTokenHash      String?       @unique
  phone               String?
  orders              Order[]       @relation("UserOrders")
  sessions            Session[]
  addresses           UserAddress[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  total             Decimal     @db.Decimal(10, 2)
  status            String      @default("PENDING")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  contactPhone      String?
  paymentMethod     String      @default("COD")
  shippingAddress   Json?
  paidAt            DateTime?
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  user              User        @relation("UserOrders", fields: [userId], references: [id])
  items             OrderItem[]
}

model OrderItem {
  id          String               @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int                  @default(1)
  price       Decimal              @db.Decimal(10, 2)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id])
  fulfillment SupplierFulfillment?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model UserAddress {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupplierFulfillment {
  id                String    @id @default(uuid())
  orderItemId       String    @unique
  supplierName      String?
  supplierProductId String?
  supplierUrl       String?
  supplierCostUsd   Decimal?  @db.Decimal(10, 2)
  status            String    @default("PENDING_REVIEW")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

/*
 * ---------------------------------------------------------------------------
 * NOVA PERFORMANCE INTELLIGENCE LAYER
 *
 * Everything above this line describes what NOVA believed BEFORE a product was
 * listed. Everything below records what actually happened AFTER it was listed,
 * which is the only thing that can ever teach the system anything.
 *
 * Status/state columns are String rather than enum to match the existing
 * schema convention and to keep forward migrations cheap on a hosted database.
 * The permitted values are declared as TypeScript unions in
 * src/lib/services/nova-contracts.ts.
 * ---------------------------------------------------------------------------
 */

/// Raw first-party behavioural events. High volume and intentionally disposable:
/// once rolled into ProductDailyMetric, rows older than the retention window are
/// pruned so a free-tier Postgres plan stays within its row/storage budget.
model ProductEvent {
  id        String   @id @default(uuid())
  productId String
  /// IMPRESSION | VIEW | ADD_TO_CART | REMOVE_FROM_CART | CHECKOUT_START | PURCHASE | REFUND
  type      String
  /// Rotating pseudonymous browser id. Not linked to a User and not a stable identifier.
  anonId    String?
  sessionId String?
  /// listing surface: home | collection | search | product | recommendation
  surface   String?
  quantity  Int      @default(1)
  valueInr  Decimal? @db.Decimal(10, 2)
  meta      Json?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, createdAt])
  @@index([createdAt])
  @@index([anonId, createdAt])
}

/// One row per product per day. All funnel questions are answered from here so
/// the storefront never scans the raw event table.
model ProductDailyMetric {
  id              String   @id @default(uuid())
  productId       String
  /// UTC midnight of the day being summarised.
  date            DateTime @db.Date
  impressions     Int      @default(0)
  views           Int      @default(0)
  addToCarts      Int      @default(0)
  checkoutStarts  Int      @default(0)
  purchases       Int      @default(0)
  unitsSold       Int      @default(0)
  refunds         Int      @default(0)
  revenueInr      Decimal  @default(0) @db.Decimal(12, 2)
  /// Contribution margin after supplier cost, shipping buffer and payment fees.
  marginInr       Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
}

/// Current position of a product in the commercial lifecycle, plus the exposure
/// lever NOVA uses to reduce risk before it resorts to delisting.
model ProductLifecycle {
  id               String    @id @default(uuid())
  productId        String    @unique
  /// CANDIDATE | TEST | LISTED | LEARNING | SCALING | MATURE | DECLINING | RETIRED
  state            String    @default("TEST")
  previousState    String?
  enteredStateAt   DateTime  @default(now())
  /// 0..100 merchandising weight. Drives ranking and homepage placement.
  exposure         Int       @default(60)
  /// Set when NOVA wants a human to confirm a consequential action.
  pendingAction    String?
  pendingReason    String?
  pendingRaisedAt  DateTime?
  /// Consecutive lifecycle passes that produced a deterioration signal.
  declineReadings  Int       @default(0)
  lastReviewedAt   DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([pendingAction])
}

/// Append-only history of lifecycle movement. Answers "how did this product get here?"
model LifecycleTransition {
  id         String   @id @default(uuid())
  productId  String
  fromState  String?
  toState    String
  /// NOVA | HUMAN | SYSTEM
  actor      String   @default("NOVA")
  reason     String
  evidence   Json?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

/// Every consequential choice NOVA makes, with the inputs that produced it.
/// This is what makes the system auditable instead of a black box.
model NovaDecision {
  id           String    @id @default(uuid())
  /// PUBLISH | EXPOSURE | PRICE | LIFECYCLE | DELIST | RETIRE | WEIGHT_UPDATE
  kind         String
  /// PRODUCT | CANDIDATE | PORTFOLIO | MODEL
  subjectType  String
  subjectId    String
  productId    String?
  /// PROPOSED | AUTO_APPLIED | AWAITING_APPROVAL | APPROVED | REJECTED | EXPIRED
  status       String    @default("PROPOSED")
  actor        String    @default("NOVA")
  summary      String
  rationale    String?
  /// The signal values the decision was computed from.
  inputs       Json?
  modelVersion String?
  confidence   Int?
  decidedAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([kind, decidedAt])
  @@index([status])
  @@index([subjectType, subjectId])
}

/// A falsifiable claim about the future. Without this table the loop cannot close.
model NovaPrediction {
  id             String    @id @default(uuid())
  productId      String?
  /// PRODUCT_SUCCESS | DEMAND_DECLINE | UNITS | CONVERSION | MARGIN
  kind           String
  /// The measurable quantity being predicted, e.g. "units_28d" or "p_decline_28d".
  metric         String
  predictedValue Decimal   @db.Decimal(12, 4)
  confidence     Int       @default(0)
  horizonDays    Int       @default(28)
  resolvesAt     DateTime
  modelVersion   String
  /// Feature vector at prediction time, so a later model can be re-scored offline.
  features       Json?
  rationale      String?
  /// PENDING | RESOLVED | ABANDONED
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  outcome        NovaOutcome?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, resolvesAt])
  @@index([productId, kind])
}

/// What reality said. Joined back to the prediction to produce an error term.
model NovaOutcome {
  id            String         @id @default(uuid())
  predictionId  String         @unique
  actualValue   Decimal        @db.Decimal(12, 4)
  /// Signed error (actual - predicted) for regression, Brier component for probabilities.
  error         Decimal        @db.Decimal(12, 4)
  /// Null when the target is continuous rather than a hit/miss claim.
  correct       Boolean?
  /// Sample size behind actualValue. Small samples must not move the model much.
  sampleSize    Int            @default(0)
  notes         String?
  resolvedAt    DateTime       @default(now())
  prediction    NovaPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

/// A versioned, auditable weight vector. NOVA scores against the active version
/// and only promotes a new one when measured accuracy actually improves.
model NovaModelVersion {
  id                String    @id @default(uuid())
  version           String    @unique
  /// Named scoring weights used by the market engine and the product evaluator.
  weights           Json
  /// SHADOW | ACTIVE | RETIRED
  status            String    @default("SHADOW")
  /// Version this one was derived from.
  parentVersion     String?
  /// Mean absolute error / Brier score over the evaluation set, lower is better.
  evaluationError   Decimal?  @db.Decimal(12, 6)
  resolvedSamples   Int       @default(0)
  changeSummary     String?
  activatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}
